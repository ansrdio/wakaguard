<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of WakaGuard's goes into backups or onto a new phone (security
  review, 4 November 2026): the sign-in and the offline copy of trips and
  contacts' numbers stay on this phone. Signing in again on a new phone
  brings everything back from the account. Android 12 and later read this;
  older phones go by allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
