rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isAllowedImageType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp'
      ];
    }

    function isUnderSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function hasSafeFilename(filename) {
      return filename.matches('^[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)$');
    }

    match /report_photos/{uid}/{reportId}/{filename} {
      allow read: if true;

      allow create: if isAuthenticated()
                    && isOwner(uid)
                    && isAllowedImageType()
                    && isUnderSizeLimit()
                    && hasSafeFilename(filename);

      allow update: if false;
      allow delete: if isAuthenticated() && isOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
