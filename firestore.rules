rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // Non-anonymous only
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return request.auth != null
        && ('admin' in request.auth.token)
        && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidReportType(t) {
      return t in ['pothole','traffic','accident','roadwork','hazard','closure','checkpoint','other'];
    }

    function isValidSeverity(s) {
      return s in ['low','medium','high','critical'];
    }

    function isValidReportStatus(s) {
      return s in ['active','resolved','expired','flagged'];
    }

    function isValidVerification(v) {
      return v in ['pending','verified','dismissed'];
    }

    function isValidCheckpointType(c) {
      return c in ['police','frsc','lastma','vio','army','customs','task_force','other'];
    }

    function isValidCheckpointCheck(x) {
      return x in ['license','vehicle_papers','insurance','road_worthiness','tinted_glass','expired_tags','random_search','particulars'];
    }

    function isValidWaitTime(w) {
      return w in ['5min','15min','30min','1hr+'];
    }

    function isValidLatLng(loc) {
      return loc.lat is number
        && loc.lng is number
        && loc.lat >= -90 && loc.lat <= 90
        && loc.lng >= -180 && loc.lng <= 180;
    }

    function isValidLocation(loc) {
      return loc is map
        && isValidLatLng(loc)
        && loc.keys().hasOnly(['lat','lng','address'])
        && (!('address' in loc) || loc.address is string);
    }

    function isValidLatLngMap(loc) {
      return loc is map
        && loc.lat is number
        && loc.lng is number
        && loc.lat >= -90 && loc.lat <= 90
        && loc.lng >= -180 && loc.lng <= 180
        && loc.keys().hasOnly(['lat','lng']);
    }

    function isValidAlertMode(m) {
      return m in ['gps','zones','both'];
    }

    function isValidRadiusKm(r) {
      return r in [2,5,10,25,50];
    }

    function isValidZone(z) {
      return z is map
        && z.keys().hasOnly(['label','center','radiusKm','state'])
        && z.label is string
        && z.label.size() > 0
        && z.label.size() <= 40
        && isValidLatLngMap(z.center)
        && isValidRadiusKm(z.radiusKm)
        && (!('state' in z) || z.state is string);
    }

    function isValidZones(zones) {
      return zones is list
        && zones.size() >= 0
        && zones.size() <= 5;
    }

    function isValidStates(states) {
      return states is list
        && states.size() >= 0
        && states.size() <= 10;
    }

    // -------------------------------------------------------------------------
    // Public civic data
    // -------------------------------------------------------------------------

    match /reports/{reportId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidReportType(request.resource.data.type)
        && isValidSeverity(request.resource.data.severity)
        && request.resource.data.status == 'active'
        && request.resource.data.state is string
        && request.resource.data.verification == 'pending'
        && isValidLocation(request.resource.data.location)
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.flagCount == 0
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5;

      // Owner can only edit specific safe fields.
      // Admin can update anything (moderation).
      allow update: if isAdmin() || (
        isAuthenticated()
        && resource.data.uid == request.auth.uid

        // immutable fields
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.type == resource.data.type
        && request.resource.data.severity == resource.data.severity
        && request.resource.data.state == resource.data.state
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && ('location' in request.resource.data)
        && ('location' in resource.data)
        && request.resource.data.location is map
        && resource.data.location is map
        && request.resource.data.location.lat == resource.data.location.lat
        && request.resource.data.location.lng == resource.data.location.lng

        // counts server-managed
        && request.resource.data.upvotes == resource.data.upvotes
        && request.resource.data.downvotes == resource.data.downvotes
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.flagCount == resource.data.flagCount

        // status + verification owner cannot change
        && request.resource.data.status == resource.data.status
        && request.resource.data.verification == resource.data.verification
        // nor the "posted from far away" mark (src/lib/reportDistance.ts)
        && request.resource.data.get('postedFarAway', null) == resource.data.get('postedFarAway', null)

        // allowed edits
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5
        && isValidLocation(request.resource.data.location)
      );

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /reports/{reportId}/resolutionVotes/{voteId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && voteId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','voteType','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.voteType in ['still_there','resolved']
        && request.resource.data.createdAt is timestamp;

      allow update: if isAuthenticated()
        && voteId == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','voteType','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.voteType in ['still_there','resolved']
        && request.resource.data.createdAt is timestamp;

      allow delete: if false;
    }

    match /resolutionLogs/{logId} {
      allow read, write: if false;
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid','reportId','text','status','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reportId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.status in ['active','removed']
        && request.resource.data.createdAt is timestamp
        ;

      // Owner can only edit text/status; cannot change linkage/identity/timestamps.
      // (If you do not need comment editing, set this to false and rely on delete.)
      allow update: if isAdmin() || (
        isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid','reportId','text','status','createdAt'])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.reportId == resource.data.reportId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.status in ['active','removed']
        // The author may take their comment down, never put back one that was
        // removed, or hidden after other people reported it
        && (request.resource.data.status == resource.data.status || request.resource.data.status == 'removed')
      );

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // votes/{uid}_{reportId}
    match /votes/{voteId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['uid','reportId','value','createdAt'])
        && voteId.matches('^' + request.auth.uid + '_[A-Za-z0-9_-]+$')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reportId is string
        && request.resource.data.value in [1, -1]
        && request.resource.data.createdAt is timestamp
        ;

      // Client updates disabled. Cloud Functions (Admin SDK) bypass rules.
      allow update, delete: if false;
    }

    match /flags/{flagId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in ['spam','inappropriate','incorrect','duplicate','other']
        && request.resource.data.targetType in ['report','comment']
        && request.resource.data.targetId is string
        && request.resource.data.details is string
        ;

      allow update: if isAdmin()
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reason == resource.data.reason
        && request.resource.data.targetType == resource.data.targetType;

      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // Users (private)
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId);

      // Fields the app itself writes. Anything else on a user document is
      // server-owned (set with the Admin SDK) and cannot be added or changed
      // from a client, so it is safe to keep moderation or account state here.
      // points, level and badges are client-written and visible only to their
      // owner; do not use them for anything of value without moving them to
      // Cloud Functions first.
      function clientUserFields() {
        return [
          'createdAt','blockedUids','username','usernameUpdatedAt','safetyChecklist','alertName',
          'points','level','badges','totalReports','totalUpvotes','totalComments',
          'tripsCompleted','loginStreak','lastLoginDate','lastReportDate','morningWeather'
        ];
      }

      function isCount(d, key) {
        return !(key in d) || (d[key] is number && d[key] >= 0);
      }

      function isValidUserData(d) {
        return (!('blockedUids' in d) || (d.blockedUids is list && d.blockedUids.size() <= 500))
          && (!('safetyChecklist' in d) || (d.safetyChecklist is list && d.safetyChecklist.size() <= 50))
          && (!('badges' in d) || (d.badges is list && d.badges.size() <= 50))
          // Name shown to trusted contacts in safety messages. The server strips
          // links and odd characters again before using it.
          && (!('alertName' in d) || (d.alertName is string && d.alertName.size() >= 1 && d.alertName.size() <= 30))
          && isCount(d, 'points') && isCount(d, 'level')
          && isCount(d, 'totalReports') && isCount(d, 'totalUpvotes') && isCount(d, 'totalComments')
          && isCount(d, 'tripsCompleted') && isCount(d, 'loginStreak')
          && (!('lastLoginDate' in d) || (d.lastLoginDate is string && d.lastLoginDate.size() <= 10))
          && (!('lastReportDate' in d) || (d.lastReportDate is string && d.lastReportDate.size() <= 10))
          // The morning weather notification, switched off in Settings (functions/src/morningWeather.ts)
          && (!('morningWeather' in d) || d.morningWeather is bool);
      }

      // A username must be reserved in /usernames by the same user, in the same
      // transaction or earlier. It is the name contacts see in safety messages.
      function ownsUsername(d) {
        return d.username is string
          && d.username.matches('^[a-zA-Z][a-zA-Z0-9_]{2,19}$')
          && getAfter(/databases/$(database)/documents/usernames/$(d.username.lower())).data.uid == request.auth.uid;
      }

      allow create: if isOwner(userId) && isAuthenticated()
        && request.resource.data.keys().hasOnly(clientUserFields())
        && isValidUserData(request.resource.data)
        && (!('username' in request.resource.data) || ownsUsername(request.resource.data));

      // Only changed fields are checked against the list, so documents that
      // carry older or server-owned fields can still be updated.
      allow update: if isOwner(userId) && isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(clientUserFields())
        && isValidUserData(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username'])
            || ownsUsername(request.resource.data));

      // Deleting and recreating the document would wipe server-owned fields
      allow delete: if false;
    }

    match /users/{userId}/pointHistory/{historyId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && isAuthenticated()
        && (
          request.resource.data.keys().hasOnly(['action','points','createdAt'])
          || request.resource.data.keys().hasOnly(['action','points','referenceId','createdAt'])
        )
        && request.resource.data.action is string
        && request.resource.data.points is number
        && request.resource.data.points >= 0
        && (!('referenceId' in request.resource.data) || request.resource.data.referenceId is string)
        && request.resource.data.createdAt is timestamp;
    }

    match /usernames/{usernameLower} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower
        ;

      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Private per-user subcollections
    // -------------------------------------------------------------------------

    match /users/{userId}/trustedContacts/{contactId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isAuthenticated();
    }

    match /users/{userId}/safetyTimers/{timerId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isAuthenticated();
    }

    match /users/{userId}/alerts/{alertId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isAuthenticated();
    }

    match /users/{userId}/checkIns/{checkInId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isAuthenticated();
    }

    // App-wide switches every phone reads (src/lib/appConfig.ts): the oldest
    // build that still works and a notice for everyone. Changed only by us.
    match /config/app {
      allow get: if true;
      allow list, write: if false;
    }

    // Numbers that asked for no more WakaGuard texts, and the tries from each
    // trip link to do so (functions/src/textOptOut.ts). Server only: the app
    // learns of it from smsOptedOut on the traveller's own contact.
    match /smsOptOuts/{phone} {
      allow read, write: if false;
    }
    match /textOptOutTries/{token} {
      allow read, write: if false;
    }
    // Where each person last looked at the weather, roughly (about 10 km),
    // for the morning notification. Server only.
    match /weatherAreas/{uid} {
      allow read, write: if false;
    }

    match /users/{userId}/trips/{tripId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // Public share docs (minimal, token-based)
    // -------------------------------------------------------------------------
    match /sharedTrips/{token} {
      // public get only when active/emergency and not expired
      allow get: if resource.data.expiresAt > request.time
        && resource.data.status in ['active','emergency'];

      allow list: if false;

      function isValidSharedTrip(d) {
        return d.keys().hasOnly([
          'uid','tripId','status','expiresAt','lastLocation','lastUpdate','destination','createdAt',
          'endsAt','overdueAt','path','name','isTest','travelMode','vehicle','destinationPoint'
        ])
        && d.uid is string
        && d.tripId is string
        && d.tripId == token
        && d.status in ['active','emergency','completed','cancelled']
        && d.expiresAt is timestamp
        && d.lastUpdate is timestamp
        && d.createdAt is timestamp
        && (!('destination' in d) || d.destination == null || d.destination is string)
        && (!('endsAt' in d) || d.endsAt == null || d.endsAt is timestamp)
        && (!('overdueAt' in d) || d.overdueAt == null || d.overdueAt is timestamp)
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('isTest' in d) || d.isTest is bool)
        && (!('travelMode' in d) || (d.travelMode is string && d.travelMode.size() <= 20))
        && (!('destinationPoint' in d) || (
          d.destinationPoint is map
          && d.destinationPoint.keys().hasOnly(['lat','lng'])
          && d.destinationPoint.lat is number && d.destinationPoint.lng is number
          && d.destinationPoint.lat >= -90 && d.destinationPoint.lat <= 90
          && d.destinationPoint.lng >= -180 && d.destinationPoint.lng <= 180
        ))
        && (!('vehicle' in d) || (
          d.vehicle is map
          && d.vehicle.keys().hasOnly(['plate','details'])
          && d.vehicle.get('plate', '') is string && d.vehicle.get('plate', '').size() <= 12
          && d.vehicle.get('details', '') is string && d.vehicle.get('details', '').size() <= 60
        ))
        && (!('path' in d) || (d.path is list && d.path.size() <= 300))
        && (!('lastLocation' in d) || d.lastLocation == null || (
          d.lastLocation is map
          && d.lastLocation.keys().hasOnly(['lat','lng','accuracy'])
          && d.lastLocation.lat is number
          && d.lastLocation.lng is number
          && d.lastLocation.lat >= -90 && d.lastLocation.lat <= 90
          && d.lastLocation.lng >= -180 && d.lastLocation.lng <= 180
          && (!('accuracy' in d.lastLocation) || d.lastLocation.accuracy is number)
        ));
      }

      // The path travelled, the traveller's name, how they are travelling and
      // their vehicle (plate, bus company or driver) are written by the server
      // (functions/src/tripMonitor.ts). They are in the list of allowed keys
      // because an update is checked against the whole document, and without
      // them every later write by the app (add time, arrive, SOS) would be
      // refused once the server had added them. The app may not set or change
      // them itself.
      function serverFieldsUntouched() {
        return request.resource.data.get('path', null) == resource.data.get('path', null)
          && request.resource.data.get('name', null) == resource.data.get('name', null)
          && request.resource.data.get('vehicle', null) == resource.data.get('vehicle', null);
      }

      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.uid
        && isValidSharedTrip(request.resource.data)
        && !('path' in request.resource.data)
        && !('name' in request.resource.data)
        && !('vehicle' in request.resource.data);

      allow update: if isAuthenticated()
        && ('uid' in resource.data)
        && resource.data.uid is string
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == resource.data.uid
        && isValidSharedTrip(request.resource.data)
        && serverFieldsUntouched();

      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.uid;
    }

    // -------------------------------------------------------------------------
    // Push subscriptions (private)
    // -------------------------------------------------------------------------
    match /pushSubscriptions/{subscriptionId} {
      allow get: if isOwner(subscriptionId) && isAuthenticated();
      allow list: if false;

      function isValidPushSub(data) {
        return data is map
          && data.keys().hasOnly([
            'uid','fcmToken','platform','appBuild','appBuildToken','location','alertMode','zones','states','createdAt','updatedAt','locationUpdatedAt'
          ])
          && data.uid == request.auth.uid
          && data.fcmToken is string
          && data.fcmToken.size() > 0
          && data.platform in ['android','ios','web']
          && (!('appBuild' in data) || (data.appBuild is int && data.appBuild > 0 && data.appBuild < 100000))
          && (!('appBuildToken' in data) || (data.appBuildToken is string && data.appBuildToken.size() <= 4096))
          && (!('alertMode' in data) || isValidAlertMode(data.alertMode))
          && (!('location' in data) || data.location == null || isValidLatLngMap(data.location))
          && (!('zones' in data) || data.zones == null || isValidZones(data.zones))
          && (!('states' in data) || data.states == null || isValidStates(data.states))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp
          && (!('locationUpdatedAt' in data) || data.locationUpdatedAt is timestamp);
      }

      allow create: if isAuthenticated()
        && subscriptionId == request.auth.uid
        && isValidPushSub(request.resource.data);

      allow update: if isAuthenticated()
        && subscriptionId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && isValidPushSub(request.resource.data);

      allow delete: if isAuthenticated()
        && subscriptionId == request.auth.uid
        && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Safety Message Logs (server-written, owner-read)
    // -------------------------------------------------------------------------
    match /safetyMessageLogs/{logId} {
      allow read: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Rate Limits (server-written, owner-read)
    // -------------------------------------------------------------------------
    match /users/{userId}/rateLimits/{docId} {
      allow read: if isOwner(userId) && isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Fault reports from the app (src/lib/errorReports.ts). Any signed-in app,
    // guests included, may add one; nobody can read or change one from the app.
    // No account is named in them. The database deletes each after about 30 days.
    // -------------------------------------------------------------------------
    match /errorReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['message', 'stack', 'where', 'build', 'version', 'platform', 'device', 'createdAt', 'deleteAfter'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.where is string && request.resource.data.where.size() <= 60
        && request.resource.data.build is int
        && request.resource.data.version is string && request.resource.data.version.size() <= 20
        && request.resource.data.platform in ['android', 'ios', 'web']
        && request.resource.data.device is string && request.resource.data.device.size() <= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.deleteAfter is timestamp
        // About 30 days, with room for a phone whose date is wrong or a report sent late
        && request.resource.data.deleteAfter > request.time + duration.value(1, 'd')
        && request.resource.data.deleteAfter < request.time + duration.value(60, 'd');
      allow read, update, delete: if false;
    }
  }
}
