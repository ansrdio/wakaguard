rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin via Firebase Custom Claims
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Helper function to check if user is authenticated (not anonymous)
    function isAuthenticated() {
      return request.auth != null 
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Allow public read for active reports (civic data should be publicly accessible)
      allow read: if true;
      
      // Allow create if authenticated (not anonymous) with proper fields
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.state is string;
      
      // Allow update for voting (authenticated users can vote)
      // Allow owner to update description/photos
      // Allow anyone to update confirmations
      allow update: if isAuthenticated();
      
      // Allow delete only by owner
      allow delete: if request.auth != null 
        && resource.data.uid == request.auth.uid;
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Allow read for all (active comments are public)
      allow read: if true;
      
      // Allow create if authenticated (not anonymous)
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      
      // Allow update only by owner
      allow update: if request.auth != null 
        && resource.data.uid == request.auth.uid;
      
      // Allow delete only by owner
      allow delete: if request.auth != null 
        && resource.data.uid == request.auth.uid;
    }
    
    // Votes collection - deterministic doc IDs prevent duplicates
    // Format: votes/{userId}_{reportId}
    match /votes/{voteId} {
      // Allow read for all authenticated users
      allow read: if isAuthenticated();
      
      // Strict write validation: doc ID must match userId_reportId pattern
      allow write: if isAuthenticated() 
        && voteId.matches('^' + request.auth.uid + '_[a-zA-Z0-9]+$')
        && (request.resource == null || (
          request.resource.data.userId == request.auth.uid
          && request.resource.data.voteType in ['up', 'down']
        ));
    }
    
    // Flags collection
    match /flags/{flagId} {
      // Allow read for authenticated users (for moderation)
      allow read: if isAuthenticated();
      
      // Allow create if authenticated (not anonymous) and user is the reporter
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in ['spam', 'inappropriate', 'incorrect', 'duplicate', 'other']
        && request.resource.data.targetType in ['report', 'comment'];
      
      // Only admins can update flags (resolve/dismiss)
      allow update: if isAdmin()
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.targetId == resource.data.targetId
        && request.resource.data.reason == resource.data.reason;
    }
    
    // Users collection
    match /users/{userId} {
      // Allow read/write only by owner
      allow read, write: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // Usernames collection - for unique username reservation
    match /usernames/{usernameLower} {
      // Allow anyone to check if username exists
      allow read: if request.auth != null;
      
      // Allow create only if user is setting their own username
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameLower == usernameLower;
      
      // No updates or deletes (usernames are permanent for now)
      allow update, delete: if false;
    }
    
    // === SAFETY FEATURES ===
    
    // Trips collection - CRITICAL SECURITY
    // Token is used as docId for secure public access
    match /trips/{tripToken} {
      // PUBLIC GET for active trips (for share links)
      // Owner can always read their own trips
      allow get: if (resource.data.status == 'active' && resource.data.expiresAt > request.time)
        || (request.auth != null && resource.data.uid == request.auth.uid);
      
      // Owner can list their own trips (needed for useSafety hook queries)
      allow list: if request.auth != null 
        && request.auth.uid != null;
      
      // Only owner can create trip
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.shareToken == tripToken
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(24, 'h');
      
      // Only owner can update trip
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && (request.resource.data.status in ['active', 'completed', 'cancelled', 'emergency'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.shareToken == resource.data.shareToken;
      
      // Only owner can delete trip
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
    
    // Trusted Contacts - private to user
    match /trustedContacts/{contactId} {
      // Only owner can read/write
      allow read, write: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
    }
    
    // Safety Timers - private to user
    match /safetyTimers/{timerId} {
      // Owner can read and list their own timers
      allow read: if request.auth != null;
      allow list: if request.auth != null;
      
      // Only owner can create
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acknowledged == false
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 240; // Max 4 hours
      
      // Only owner can update (to acknowledge)
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      
      // Only owner can delete
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
    
    // Alerts - private to user
    match /alerts/{alertId} {
      // Only owner can read
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      
      // Only owner can create
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['sos', 'timer_expired', 'check_in_missed', 'checkpoint_stop']
        && request.resource.data.acknowledged == false;
      
      // Only owner can update (to acknowledge)
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid;
      
      // Only owner can delete
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
    
    // Check-ins - private to user
    match /checkIns/{checkInId} {
      // Only owner can read
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      
      // Only owner can create
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      
      // Only owner can delete
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
