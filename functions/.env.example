# =============================================================================
# WAKAGUARD CLOUD FUNCTIONS CONFIGURATION
# =============================================================================
# Copy this file to functions/.env and fill it in. The Firebase CLI loads it
# when you deploy. NEVER commit functions/.env to version control.
# Full instructions: docs/SAFETY-ALERTS-SETUP.md
# =============================================================================

# --- SMS provider -------------------------------------------------------------
# termii | twilio | mock   (mock logs messages and sends nothing)
SMS_PROVIDER=termii
# Optional second provider, tried for each recipient when the first one fails
# SMS_FALLBACK_PROVIDER=twilio
# Set to false to stop all SMS without redeploying code changes
# SMS_ENABLED=true

# --- Termii -------------------------------------------------------------------
TERMII_API_KEY=your-termii-api-key
# Approved sender ID, 3 to 11 characters
TERMII_SENDER_ID=WakaGuard
# Base URL shown on your Termii dashboard
TERMII_BASE_URL=https://v3.api.termii.com
# dnd = transactional route that reaches numbers with Do-Not-Disturb on.
# It must be activated on the Termii account. generic = promotional route.
TERMII_CHANNEL=dnd

# --- Twilio (only if used as provider or fallback) ----------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+15005550006

# --- Account emails -----------------------------------------------------------
# brevo | mock   (mock logs emails and sends nothing)
# Leave unset and WakaGuard sends no email itself: the app asks Firebase for its
# built-in "verify your email" and "reset your password" emails instead, whose
# link is on Firebase's address. See docs/SAFETY-ALERTS-SETUP.md.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# The sender's domain must be authenticated in Brevo
# MAIL_FROM_EMAIL=noreply@wakaguard.com
# MAIL_FROM_NAME=WakaGuard
# MAIL_REPLY_TO=
# Emails per account
# EMAIL_MAX_PER_HOUR=6
# EMAIL_MAX_PER_TYPE_PER_HOUR=5
# EMAIL_MAX_PER_DAY=15

# --- Links in messages --------------------------------------------------------
# Public address of the app. Trip links in SMS are built from it.
APP_BASE_URL=https://wakaguard.com

# --- Limits (messages per user; one message = one recipient) ------------------
# SMS_MAX_PER_HOUR=30
# SMS_MAX_PER_TYPE_PER_HOUR=15
# SMS_MAX_PER_DAY=50

# --- App Check ----------------------------------------------------------------
# Set to true only after App Check is registered and the app sends tokens.
# ENFORCE_APP_CHECK=false
