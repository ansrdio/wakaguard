# =============================================================================
# ROADPULSE / WAKAGUARD ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your Firebase credentials.
# NEVER commit .env.local to version control!
#
# Get these values from Firebase Console:
# https://console.firebase.google.com/ > Project Settings > General > Your apps
# =============================================================================

# Firebase Web App Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Google Maps API Key (for geocoding features)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Public address of the app, used when building trip share links.
# Defaults to https://wakaguard.com
# NEXT_PUBLIC_APP_URL=https://wakaguard.com

# Region the Cloud Functions are deployed to. Defaults to us-central1
# NEXT_PUBLIC_FUNCTIONS_REGION=us-central1

# App Check (optional): reCAPTCHA v3 site key registered for this app in
# Firebase Console > App Check. Leave unset to keep App Check off.
# NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key
# Local development only. 'true' prints a debug token in the browser console
# to register in Firebase Console > App Check > Manage debug tokens.
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=true

# Map background tiles (optional). By default the map uses OpenStreetMap's
# tile server, which needs no key but only allows light traffic. For a wider
# launch, use a provider with an API key, in Leaflet's URL template format.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=your-key
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Local development against the Firebase emulators (optional).
# With this on, and only on localhost, the app talks to the emulators started
# by `npm run emulators:all` instead of a real project. Use the demo project
# values below so nothing real can be touched, then run `npm run seed:emulator`.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# NEXT_PUBLIC_FIREBASE_API_KEY=demo
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-wakaguard.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-wakaguard
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-wakaguard.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
# NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
